{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tidewise-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "tidewise-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/node_modules/vite/bin/vite.js",
        "web",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}